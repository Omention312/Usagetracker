<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UsageTracker.Engine</RootNamespace>
    <AssemblyName>UsageTracker.Engine</AssemblyName>
    <!-- 应用图标:任务栏/标题栏/Alt-Tab 统一(运行时经 Icon.ExtractAssociatedIcon 再取) -->
    <ApplicationIcon>..\..\assets\UsageTracker.ico</ApplicationIcon>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageTracker.Core\UsageTracker.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
